# Placeholder values only. Copy to .env (gitignored) and fill in real values locally.

# Main database (used by the app, db:migrate, db:seed, db:reset)
DATABASE_URL=postgres://<db-user>:<db-password>@localhost:5432/blogflow

# Separate database for Jest. It is wiped and re-seeded on every test run – never point it at real data.
TEST_DATABASE_URL=postgres://<db-user>:<db-password>@localhost:5432/blogflow_test

# Password given to all 5 seeded demo users (choose your own, at least 8 characters)
SEED_USER_PASSWORD=<choose-a-demo-password>

# Used from Part 2 onwards
PORT=3000
JWT_SECRET=<long-random-string-at-least-32-chars>
