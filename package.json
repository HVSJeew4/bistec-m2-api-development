{
  "name": "blogflow-api",
  "version": "1.0.0",
  "description": "BlogFlow API – RESTful blog backend (Express, PostgreSQL, JWT)",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node database/seeds/seed.js",
    "db:reset": "node scripts/reset-db.js",
    "postman:build": "node postman/build-collection.js",
    "test:postman": "npx --yes newman@6.2.3 run postman/BlogFlow.postman_collection.json -e postman/BlogFlow.postman_environment.json",
    "submission": "node scripts/package-submission.js"
  },
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "entities": "^9.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
