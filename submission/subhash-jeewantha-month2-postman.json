                  "pm.test('database is up', () => pm.expect(pm.response.json().data).to.eql({ status: 'ok', database: 'up' }));",
                  "pm.test('sends rate-limit headers', () => pm.response.to.have.header('RateLimit-Policy', '100;w=60'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          }
        }
