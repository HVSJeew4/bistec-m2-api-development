                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('links to the main resources', () => pm.expect(pm.response.json().data.links).to.include.keys('posts', 'docs'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
